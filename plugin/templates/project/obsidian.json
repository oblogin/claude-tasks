{
  "app.json": {
    "propertiesInDocument": "hidden",
    "showInlineTitle": false
  },
  "graph.json": {
    "search": "-file:Board -file:Readme",
    "showArrow": true,
    "colorGroups": [
      {
        "query": "file:/^E-[0-9]+ /",
        "color": {
          "a": 1,
          "rgb": 15026253
        }
      },
      {
        "query": "file:/^F-[0-9]+ /",
        "color": {
          "a": 1,
          "rgb": 16098596
        }
      },
      {
        "query": "file:/^F[0-9]+-[0-9]+ /",
        "color": {
          "a": 1,
          "rgb": 3900150
        }
      },
      {
        "query": "path:Adr",
        "color": {
          "a": 1,
          "rgb": 3187820
        }
      },
      {
        "query": "path:Backlog",
        "color": {
          "a": 1,
          "rgb": 9145752
        }
      }
    ]
  }
}
